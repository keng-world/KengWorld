ba \u89e3\u91ca : \u8fd9\u4e00\u7406\u8bba\u4e3b\u8981\u9610\u91ca\u672c\u4e16\u754c\u89c2\u4e4b\u4e2d\u6240\u6709\u7684\u5b87\u5b99\u5747\u5904\u4e8e\u4e00\u4e2a\u7535\u8111\u4e4b\u4e2d\uff0c\u8be5\u7535\u8111\u7684\u5b9e\u4f53\u4f4d\u7f6e\u5904\u4e8e\u4e00\u4e2a\u62e5\u6709\u56db\u7ef4\u7a7a\u95f4\uff0c\u4e8c\u7ef4\u65f6\u95f4\u7684\u5b87\u5b99\uff0c\u5e76\u7531\u4e00\u4e2a\u53eb\u505aAdministrator(\u7ba1\u7406\u5458)\u7684\u5b9e\u4f53\u7ba1\u7406\u3002 \u80fd\u91cf\u5b88\u6052\u5b9a\u5f8b \u89e3\u91ca : \u4efb\u4f55\u4e00\u4e2a\u5b87\u5b99\u6240\u5206\u914d\u7684\u5185\u5b58\u5355\u5143\u4e00\u5b9a \u57fa\u672c\u89c2\u5ff5 \u89e3\u91ca : \u89c4\u5219\u5206\u914d\u80fd\u91cf\u6539\u53d8\u7269\u8d28 \u7269\u8d28 -> \u5185\u5b58\u5355\u5143 \u80fd\u91cf -> \u5185\u5b58\u72b6\u6001 \u89c4\u5219 -> \u8fd0\u884c\u4ee3\u7801 \u7aef\u53e3 \u5b9a\u4e49 : \u7528\u6765\u89c2\u6d4b\u5b87\u5b99\u7684\u5b9e\u4f53\uff0cAdministrator\u53ef\u4ee5\u5bf9\u5176\u76f4\u63a5\u8fdb\u884c\u4ea4\u4e92 \u5751\u56e0\u7ec8\u7aef \u5b9a\u4e49 : \u4e00\u4e2a\u5728\u5b87\u5b99\u5185\u90e8\u53ef\u4ee5\u8ba9\u7aef\u53e3\u8fd0\u884c\u4ee3\u7801\u7684\u5e73\u53f0 \u5751\u56e0\u7ec8\u7aefv2 \u8bf4\u660e : \u7ecf\u5c51\u5a18\u6539\u9020\u7684\u5751\u56e0\u7ec8\u7aef\uff0c\u62e5\u6709\u7f16\u8f91\u6587\u4ef6\uff0c\u8fd0\u884c\u4ee3\u7801\u7684\u591a\u529f\u80fdIDE(\u96c6\u6210\u5f00\u53d1\u73af\u5883)","title":"Theory1"},{"location":"theory/theory1/#_1","text":"\u89e3\u91ca : \u8fd9\u4e00\u7406\u8bba\u4e3b\u8981\u9610\u91ca\u672c\u4e16\u754c\u89c2\u4e4b\u4e2d\u6240\u6709\u7684\u5b87\u5b99\u5747\u5904\u4e8e\u4e00\u4e2a\u7535\u8111\u4e4b\u4e2d\uff0c\u8be5\u7535\u8111\u7684\u5b9e\u4f53\u4f4d\u7f6e\u5904\u4e8e\u4e00\u4e2a\u62e5\u6709\u56db\u7ef4\u7a7a\u95f4\uff0c\u4e8c\u7ef4\u65f6\u95f4\u7684\u5b87\u5b99\uff0c\u5e76\u7531\u4e00\u4e2a\u53eb\u505aAdministrator(\u7ba1\u7406\u5458)\u7684\u5b9e\u4f53\u7ba1\u7406\u3002","title":"\u5751\u56e0\u4e3b\u673a\u7406\u8bba"},{"location":"theory/theory1/#_2","text":"\u89e3\u91ca : \u4efb\u4f55\u4e00\u4e2a\u5b87\u5b99\u6240\u5206\u914d\u7684\u5185\u5b58\u5355\u5143\u4e00\u5b9a","title":"\u80fd\u91cf\u5b88\u6052\u5b9a\u5f8b"},{"location":"theory/theory1/#_3","text":"\u89e3\u91ca : \u89c4\u5219\u5206\u914d\u80fd\u91cf\u6539\u53d8\u7269\u8d28 \u7269\u8d28 -> \u5185\u5b58\u5355\u5143 \u80fd\u91cf -> \u5185\u5b58\u72b6\u6001 \u89c4\u5219 -> \u8fd0\u884c\u4ee3\u7801","title":"\u57fa\u672c\u89c2\u5ff5"},{"location":"theory/theory1/#_4","text":"\u5b9a\u4e49 : \u7528\u6765\u89c2\u6d4b\u5b87\u5b99\u7684\u5b9e\u4f53\uff0cAdministrator\u53ef\u4ee5\u5bf9\u5176\u76f4\u63a5\u8fdb\u884c\u4ea4\u4e92","title":"\u7aef\u53e3"},{"location":"theory/theory1/#_5","text":"\u5b9a\u4e49 : \u4e00\u4e2a\u5728\u5b87\u5b99\u5185\u90e8\u53ef\u4ee5\u8ba9\u7aef\u53e3\u8fd0\u884c\u4ee3\u7801\u7684\u5e73\u53f0","title":"\u5751\u56e0\u7ec8\u7aef"},{"location":"theory/theory1/#v2","text":"\u8bf4\u660e : \u7ecf\u5c51\u5a18\u6539\u9020\u7684\u5751\u56e0\u7ec8\u7aef\uff0c\u62e5\u6709\u7f16\u8f91\u6587\u4ef6\uff0c\u8fd0\u884c\u4ee3\u7801\u7684\u591a\u529f\u80fdIDE(\u96c6\u6210\u5f00\u53d1\u73af\u5883)","title":"\u5751\u56e0\u7ec8\u7aefv2"},{"location":"theory/theory2/","text":"\u65f6\u7a7a\u7406\u8bba \u57fa\u672c\u5b9a\u4e49 \u6839\u636e\u4e3b\u673a\u7406\u8bba\uff0c \u8f74","title":"Theory2"},{"location":"theory/theory2/#_1","text":"","title":"\u65f6\u7a7a\u7406\u8bba"},{"location":"theory/theory2/#_2","text":"\u6839\u636e\u4e3b\u673a\u7406\u8bba\uff0c","title":"\u57fa\u672c\u5b9a\u4e49"},{"location":"theory/theory2/#_3","text":"","title":"\u8f74"},{"location":"theory/theoryIndex/","text":"\u7406\u8bba\u5217\u8868 \u4e3b\u673a\u7406\u8bba \u65f6\u7a7a\u7406\u8bba \u9b54\u6cd5\u7406\u8bba","title":"theoryIndex"},{"location":"theory/theoryIndex/#_1","text":"\u4e3b\u673a\u7406\u8bba \u65f6\u7a7a\u7406\u8bba \u9b54\u6cd5\u7406\u8bba","title":"\u7406\u8bba\u5217\u8868"}]}